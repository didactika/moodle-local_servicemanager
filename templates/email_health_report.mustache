{{!
    @template local_servicemanager/email_health_report

    Email template for health check reports.

    Context variables required for this template:
    * lang - Language tag of the report, for the html lang attribute
    * site_name - Name of the Moodle site
    * site_url - URL of the Moodle site
    * report_date - Formatted date
    * status_class - 'success', 'warning', or 'danger'
    * status_text - Overall status text
    * summary_text - Brief summary
    * has_issues - Boolean
    * issues - Array of issues
    * healthy_schemas - Array of healthy schemas (optional, if detailed report)
    * dashboard_url - Link to dashboard
    * status_style - Colours of the banner of the headline, as a style attribute
    * issues[].badge_style - Colours of the label of each issue, as a style attribute

    The mail is read outside Moodle, where a stylesheet of the plugin does not reach, so every style is written on its element.

    Example context (json):
    {
        "lang": "en",
        "site_name": "Example Moodle Site",
        "site_url": "https://example.com",
        "report_date": "1 January 2026, 12:00",
        "primary_color": "#0f6674",
        "status_class": "success",
        "status_style": "background-color: #28a745; color: #ffffff;",
        "status_text": "All service schemas are healthy.",
        "summary_text": "All service schemas are operating normally.",
        "has_issues": false,
        "has_healthy": false,
        "dashboard_url": "https://example.com/local/servicemanager/pages/dashboard.php"
    }
}}
<!DOCTYPE html>
<html lang="{{lang}}">
<head>
    <meta charset="UTF-8">
    <title>{{#str}}healthcheck_report_subject, local_servicemanager{{/str}}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; color: #333333; line-height: 1.6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e0e0e0; border-radius: 4px; overflow: hidden;">
        <div style="background-color: {{primary_color}}; color: #ffffff; padding: 20px; text-align: center;">
            {{#logo_url}}
            <img src="{{logo_url}}" alt="{{site_name}}" style="max-height: 75px; max-width: 100%; height: auto;">
            {{/logo_url}}
            {{^logo_url}}
            <h1 style="margin: 0; font-size: 24px; font-weight: normal;">{{site_name}}</h1>
            {{/logo_url}}
        </div>

        <div style="padding: 15px; text-align: center; font-weight: bold; font-size: 18px; {{status_style}}">
            {{status_text}}
        </div>

        <div style="padding: 20px;">
            <p><strong>{{report_date}}</strong></p>
            <p>{{summary_text}}</p>

            {{#has_issues}}
            <h3>{{#str}}issues, local_servicemanager{{/str}}</h3>
            {{#issues}}
            <div style="border-bottom: 1px solid #eeeeee; padding: 15px 0;">
                <div style="font-weight: bold; font-size: 16px;">
                    {{name}}
                    <span style="display: inline-block; padding: 0.25em 0.4em; font-size: 75%; font-weight: 700; line-height: 1; text-align: center; white-space: nowrap; vertical-align: baseline; border-radius: 0.25rem; {{badge_style}}">{{status_label}}</span>
                </div>
                <div style="color: #666666; font-size: 14px; font-family: monospace;">{{schema_id}}</div>
                <ul style="margin-top: 5px; padding-left: 20px; color: #d9534f;">
                    {{#messages}}
                    <li>{{.}}</li>
                    {{/messages}}
                </ul>
                <a href="{{view_url}}" style="font-size: 12px;">{{#str}}view_schema, local_servicemanager{{/str}}</a>
            </div>
            {{/issues}}
            {{/has_issues}}

            {{#has_healthy}}
            <h3 style="margin-top: 20px;">{{#str}}status_healthy, local_servicemanager{{/str}}</h3>
            <ul>
                {{#healthy_schemas}}
                <li>
                    <strong>{{name}}</strong> <span style="color: #666666;">({{schema_id}})</span>
                </li>
                {{/healthy_schemas}}
            </ul>
            {{/has_healthy}}

            <div style="text-align: center;">
                <a href="{{dashboard_url}}" style="display: inline-block; padding: 10px 20px; margin-top: 15px; background-color: {{primary_color}}; color: #ffffff; text-decoration: none; border-radius: 4px;">{{#str}}dashboard, local_servicemanager{{/str}}</a>
            </div>
        </div>

        <div style="background-color: #f8f9fa; border-top: 1px solid #e0e0e0; padding: 15px; text-align: center; font-size: 12px; color: #6c757d;">
            {{#logo_url}}
            <img src="{{logo_url}}" alt="{{site_name}}" style="max-height: 50px; margin-bottom: 10px;">
            {{/logo_url}}
            <p>{{#str}}email_footer, local_servicemanager{{/str}}</p>
            <a href="{{site_url}}" style="color: {{primary_color}};">{{site_url}}</a>
        </div>
    </div>
</body>
</html>
