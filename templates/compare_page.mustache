{{!
    @template local_servicemanager/compare_page

    The comparison of two versions of a schema.

    Context variables required for this template:
    * backurl - Where Back leads
    * first, second - The versions
    * identical, added, removed, changed - What differs, with the labels that say it
    * areas - What changed, said in terms of the schema
    * split, unified - The rows of each layout

    Example context (json):
    {
        "backurl": "#",
        "first": {"version": "1.0.0", "date": "today", "user": "Admin", "viewurl": "#"},
        "second": {"version": "1.1.0", "date": "today", "user": "Admin", "viewurl": "#"},
        "identical": false,
        "added": 1,
        "removed": 0,
        "changed": 0,
        "addedlabel": "1 added",
        "removedlabel": "0 removed",
        "changedlabel": "0 changed",
        "areas": [],
        "hasareas": false,
        "hasstarts": true,
        "changescount": 0,
        "split": [],
        "unified": []
    }
}}
<div class="servicemanager-compare-page{{#legacyicons}} sm-fa4{{/legacyicons}}" data-region="servicemanager-compare">
    <div class="sm-block">
        <a href="{{backurl}}" class="btn btn-secondary"><i class="fa-solid fa-arrow-left sm-icon-gap" aria-hidden="true"></i>{{#str}}back, local_servicemanager{{/str}}</a>
    </div>
    <header class="sm-page-header">
        <div class="sm-page-title">
            <h2 class="sm-flush">{{#str}}compare_versions, local_servicemanager{{/str}}</h2>
            <p class="sm-muted sm-flush">
                <a href="{{first.viewurl}}">{{#str}}version, local_servicemanager{{/str}} {{first.version}}</a>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                <a href="{{second.viewurl}}">{{#str}}version, local_servicemanager{{/str}} {{second.version}}</a>
                · {{second.user}}, {{second.date}}
            </p>
        </div>
    </header>

    <div class="sm-badges-row sm-block" data-region="diff-counts">
        {{#identical}}<span class="sm-badge tone-secondary">{{#str}}compare_no_changes, local_servicemanager{{/str}}</span>{{/identical}}
        {{^identical}}
            {{#added}}<span class="sm-badge tone-success">{{addedlabel}}</span>{{/added}}
            {{#removed}}<span class="sm-badge tone-danger">{{removedlabel}}</span>{{/removed}}
            {{#changed}}<span class="sm-badge tone-warning">{{changedlabel}}</span>{{/changed}}
        {{/identical}}
    </div>

    {{#hasareas}}
        <details class="sm-changes sm-block" data-region="change-summary" open>
            <summary class="sm-changes-head">
                <i class="fa-solid fa-chevron-right sm-changes-caret" aria-hidden="true"></i>
                <h5 class="sm-changes-title">{{#str}}compare_changes_title, local_servicemanager{{/str}}</h5>
                <span class="sm-count-badge">{{changescount}}</span>
            </summary>
            <div class="sm-changes-body">
                {{#areas}}
                    <section class="sm-changes-area">
                        <h6 class="sm-changes-area-title"><i class="fa-solid fa-{{icon}} sm-icon-gap" aria-hidden="true"></i>{{title}}</h6>
                        <ul class="sm-changes-list">
                            {{#items}}
                                <li class="sm-change-chip tone-{{tone}}">
                                    <i class="fa-solid fa-{{icon}} sm-change-sign" aria-hidden="true"></i>
                                    <span class="sr-only visually-hidden">{{kindlabel}}: </span>
                                    <span class="sm-change-name">{{label}}</span>
                                    {{#iskindchanged}}
                                        <span class="sm-change-values">
                                            <span class="sm-change-from">{{from}}</span>
                                            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                            <span class="sm-change-to">{{to}}</span>
                                        </span>
                                    {{/iskindchanged}}
                                </li>
                            {{/items}}
                        </ul>
                    </section>
                {{/areas}}
            </div>
        </details>
    {{/hasareas}}

    <div class="sm-actions-row sm-spread sm-block" data-region="diff-tools">
        <div class="sm-group" role="group" aria-label="{{#str}}compare_view, local_servicemanager{{/str}}">
            <button type="button" class="btn sm-pill active" data-view="split" aria-pressed="true">
                <i class="fa-solid fa-table-columns sm-icon-gap" aria-hidden="true"></i>{{#str}}compare_view_split, local_servicemanager{{/str}}
            </button>
            <button type="button" class="btn sm-pill" data-view="unified" aria-pressed="false">
                <i class="fa-solid fa-bars sm-icon-gap" aria-hidden="true"></i>{{#str}}compare_view_unified, local_servicemanager{{/str}}
            </button>
        </div>
        <div class="sm-actions-row">
            <div class="custom-control custom-switch form-check form-switch sm-switch">
                <input class="custom-control-input form-check-input" type="checkbox" role="switch" id="only-changes" checked>
                <label class="custom-control-label form-check-label" for="only-changes">{{#str}}compare_only_changes, local_servicemanager{{/str}}</label>
            </div>
        </div>
    </div>

    <div class="card sm-diff-card">
        <div class="table-responsive">
            <table class="table table-sm comparison-table sm-diff-split" data-region="diff-split">
                <thead>
                    <tr>
                        <th colspan="2">{{#str}}version, local_servicemanager{{/str}} {{first.version}} <small class="sm-muted">{{first.date}}</small></th>
                        <th colspan="2">{{#str}}version, local_servicemanager{{/str}} {{second.version}} <small class="sm-muted">{{second.date}}</small></th>
                    </tr>
                </thead>
                <tbody>
                    {{#split}}
                        {{#opensfold}}<tr class="sm-folded" data-region="fold" data-from="{{index}}"><td colspan="4"><button type="button" class="btn btn-sm btn-link" data-action="open-fold"><i class="fa-solid fa-ellipsis sm-icon-gap" aria-hidden="true"></i>{{foldlabel}}</button></td></tr>{{/opensfold}}
                        <tr id="diff-row-{{index}}" data-row="{{index}}"{{#folded}} data-fold="{{foldfrom}}"{{/folded}}>
                            <td class="sm-line-no" aria-hidden="true">{{leftno}}</td>
                            <td class="sm-diff sm-diff-{{leftkind}}">{{lefttext}}</td>
                            <td class="sm-line-no" aria-hidden="true">{{rightno}}</td>
                            <td class="sm-diff sm-diff-{{rightkind}}">{{righttext}}</td>
                        </tr>
                    {{/split}}
                </tbody>
            </table>
            <table class="table table-sm sm-diff-unified" data-region="diff-unified" hidden>
                <thead>
                    <tr>
                        <th colspan="4">{{#str}}version, local_servicemanager{{/str}} {{first.version}} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i> {{#str}}version, local_servicemanager{{/str}} {{second.version}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#unified}}
                        {{#opensfold}}<tr class="sm-folded" data-region="fold" data-from="{{index}}"><td colspan="4"><button type="button" class="btn btn-sm btn-link" data-action="open-fold"><i class="fa-solid fa-ellipsis sm-icon-gap" aria-hidden="true"></i>{{foldlabel}}</button></td></tr>{{/opensfold}}
                        <tr data-row="{{index}}"{{#folded}} data-fold="{{foldfrom}}"{{/folded}}>
                            <td class="sm-line-no" aria-hidden="true">{{leftno}}</td>
                            <td class="sm-line-no" aria-hidden="true">{{rightno}}</td>
                            <td class="sm-sign">{{sign}}</td>
                            <td class="sm-diff sm-diff-{{kind}}">{{text}}</td>
                        </tr>
                    {{/unified}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{#hasstarts}}
    <div class="sm-floating sm-changenav" role="status" data-region="change-navigator">
        <button type="button" class="sm-navbtn" data-action="prev-change" title="{{#str}}compare_prev_change, local_servicemanager{{/str}}">
            <i class="fa-solid fa-chevron-up" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}compare_prev_change, local_servicemanager{{/str}}</span>
        </button>
        <span class="sm-changenav-info">
            <strong data-region="change-title"></strong>
            <small data-region="change-detail"></small>
        </span>
        <button type="button" class="sm-navbtn" data-action="next-change" title="{{#str}}compare_next_change, local_servicemanager{{/str}}">
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}compare_next_change, local_servicemanager{{/str}}</span>
        </button>
    </div>
{{/hasstarts}}
{{#js}}
require(['local_servicemanager/compare'], function(compare) {
    compare.init();
});
{{/js}}
