{{!
    @template local_serviceschema/schema_detail

    Schema detail view template.

    Context variables required for this template:
    * schema_id - String
    * name - String
    * version - String
    * description - String
    * status - String
    * status_label - String
    * status_class - String
    * status_icon - String
    * functions - Array
    * new_token - String (optional, for newly generated tokens)
    * can_manage - Boolean
}}

<div class="serviceschema-detail">
    {{! Back button }}
    <div class="mb-4">
        <a href="{{dashboard_url}}" class="btn btn-secondary">
            <i class="fa fa-arrow-left mr-2"></i>{{#str}}dashboard, local_serviceschema{{/str}}
        </a>
    </div>

    {{! Token display for newly generated tokens }}
    {{#show_new_token}}
    <div class="alert alert-success token-display mb-4" role="alert">
        <h4 class="alert-heading">
            <i class="fa fa-key mr-2"></i>{{#str}}token_generated, local_serviceschema{{/str}}
        </h4>
        <p class="mb-3">{{#str}}token_copy_warning, local_serviceschema{{/str}}</p>
        <hr>
        <div class="input-group">
            <input type="text" class="form-control font-monospace" value="{{new_token}}" readonly id="new-token-value">
            <div class="input-group-append">
                <button class="btn btn-success copy-token" type="button" data-token="{{new_token}}" data-target="new-token-value">
                    <i class="fa fa-copy mr-1"></i>{{#str}}copy, local_serviceschema{{/str}}
                </button>
            </div>
        </div>
    </div>
    {{/show_new_token}}

    {{! Header card }}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="mb-0">{{name}}</h3>
            <span class="badge {{status_class}} badge-lg">
                <i class="fa {{status_icon}} mr-1"></i>{{status_label}}
            </span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">{{#str}}schema_id, local_serviceschema{{/str}}</dt>
                        <dd class="col-sm-8"><code>{{schema_id}}</code></dd>

                        <dt class="col-sm-4">{{#str}}schema_version, local_serviceschema{{/str}}</dt>
                        <dd class="col-sm-8">{{version}}</dd>

                        {{#maintainer}}
                        <dt class="col-sm-4">{{#str}}schema_maintainer, local_serviceschema{{/str}}</dt>
                        <dd class="col-sm-8">{{maintainer}}</dd>
                        {{/maintainer}}
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">{{#str}}schema_created, local_serviceschema{{/str}}</dt>
                        <dd class="col-sm-8">{{timecreated}}</dd>

                        <dt class="col-sm-4">{{#str}}schema_modified, local_serviceschema{{/str}}</dt>
                        <dd class="col-sm-8">{{timemodified}}</dd>

                        <dt class="col-sm-4">{{#str}}schema_enabled, local_serviceschema{{/str}}</dt>
                        <dd class="col-sm-8">
                            {{#enabled}}<span class="badge badge-success">{{#str}}yes{{/str}}</span>{{/enabled}}
                            {{^enabled}}<span class="badge badge-secondary">{{#str}}no{{/str}}</span>{{/enabled}}
                        </dd>
                    </dl>
                </div>
            </div>

            {{#description}}
            <hr>
            <p class="text-muted mb-0">{{description}}</p>
            {{/description}}
        </div>

        {{#can_manage}}
        <div class="card-footer">
            <a href="{{edit_url}}" class="btn btn-primary">
                <i class="fa fa-edit mr-1"></i>{{#str}}action_edit, local_serviceschema{{/str}}
            </a>
            {{#has_token}}
            <a href="{{regenerate_url}}" class="btn btn-warning">
                <i class="fa fa-refresh mr-1"></i>{{#str}}action_regenerate_token, local_serviceschema{{/str}}
            </a>
            {{/has_token}}
            <a href="{{delete_url}}" class="btn btn-danger float-right">
                <i class="fa fa-trash mr-1"></i>{{#str}}action_delete, local_serviceschema{{/str}}
            </a>
        </div>
        {{/can_manage}}
    </div>

    {{! Functions section }}
    {{#has_functions}}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">{{#str}}functions, local_serviceschema{{/str}}</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>{{#str}}function_name, local_serviceschema{{/str}}</th>
                        <th class="text-center">{{#str}}function_critical, local_serviceschema{{/str}}</th>
                        <th class="text-center">{{#str}}function_status, local_serviceschema{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#functions}}
                    <tr>
                        <td><code>{{name}}</code></td>
                        <td class="text-center">
                            {{#critical}}<span class="badge badge-danger">{{#str}}yes{{/str}}</span>{{/critical}}
                            {{^critical}}<span class="badge badge-secondary">{{#str}}no{{/str}}</span>{{/critical}}
                        </td>
                        <td class="text-center">
                            <span class="{{status_class}}">
                                <i class="fa {{status_icon}} mr-1"></i>{{status_label}}
                            </span>
                        </td>
                    </tr>
                    {{/functions}}
                </tbody>
            </table>
        </div>
    </div>
    {{/has_functions}}

    {{! Extra capabilities section }}
    {{#has_extra_capabilities}}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">{{#str}}extra_capabilities, local_serviceschema{{/str}}</h5>
        </div>
        <ul class="list-group list-group-flush">
            {{#extra_capabilities}}
            <li class="list-group-item"><code>{{.}}</code></li>
            {{/extra_capabilities}}
        </ul>
    </div>
    {{/has_extra_capabilities}}

    {{! Health logs section }}
    {{#has_health_logs}}
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">{{#str}}healthcheck_task, local_serviceschema{{/str}}</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th style="width: 200px;">{{#str}}time{{/str}}</th>
                        <th style="width: 100px;">{{#str}}status{{/str}}</th>
                        <th>{{#str}}message{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#health_logs}}
                    <tr>
                        <td>{{time}}</td>
                        <td><span class="badge {{status_class}}">{{status}}</span></td>
                        <td>{{message}}</td>
                    </tr>
                    {{/health_logs}}
                </tbody>
            </table>
        </div>
    </div>
    {{/has_health_logs}}
</div>
