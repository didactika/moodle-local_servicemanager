{{!
    @template local_servicemanager/schema_detail

    One schema, or one past version of it: what it says, what it provisioned and how healthy it is.

    Context variables required for this template:
    * ishistory, canmanage, sesskey - What the page is and what the person may do
    * backurl, backlabel - Where Back leads
    * schema - What the schema is
    * functions, resources, access, role - The panels
    * health - A summary of the health checks: the latest one, the count of each status and where all of them are
    * urls - Where the actions lead

    Example context (json):
    {
        "ishistory": false,
        "canmanage": true,
        "sesskey": "abc",
        "backurl": "#",
        "backlabel": "Dashboard",
        "schema": {"schemaid": "a.b", "name": "A service", "version": "1.0.0", "description": "", "maintainer": "", "statuslabel": "Healthy", "tone": "success", "icon": "circle-check", "enabled": true, "created": "today", "modified": "today"},
        "hasnewtoken": false,
        "hastoken": false,
        "hasfunctions": false,
        "functions": [],
        "hasresources": false,
        "resources": [],
        "access": {"showfiles": true, "files": [], "hasplugins": false, "plugins": [], "hascapabilities": false, "capabilities": []},
        "role": {"visible": false, "rows": []},
        "health": {
            "hasany": true,
            "latest": {"time": "15/10/26, 21:43", "statuslabel": "Warning", "tone": "warning", "messages": [{"text": "Service: disabled"}]},
            "counts": [{"label": "Healthy", "count": 9, "tone": "success"}, {"label": "Warning", "count": 1, "tone": "warning"}],
            "total": 10,
            "url": "#"
        },
        "urls": {"edit": "#", "delete": "#", "history": "#", "regenerate": "#", "export": "#", "bulk": "#"},
        "schemarowid": 1
    }
}}
<div class="servicemanager-detail{{#legacyicons}} sm-fa4{{/legacyicons}}" data-region="servicemanager-detail" data-has-token="{{#hastoken}}1{{/hastoken}}{{^hastoken}}0{{/hastoken}}" data-bulk-url="{{urls.bulk}}" data-sesskey="{{sesskey}}" data-id="{{schemarowid}}" data-name="{{schema.name}}" data-enabled="{{#schema.enabled}}1{{/schema.enabled}}{{^schema.enabled}}0{{/schema.enabled}}">
    <div class="sm-block">
        <a href="{{backurl}}" class="btn btn-secondary"><i class="fa-solid fa-arrow-left sm-icon-gap" aria-hidden="true"></i>{{backlabel}}</a>
    </div>

    {{#hasnewtoken}}
        <div class="alert alert-success" role="alert" data-region="new-token">
            <h4 class="alert-heading"><i class="fa-solid fa-key sm-icon-gap" aria-hidden="true"></i>{{#str}}token_generated, local_servicemanager{{/str}}</h4>
            <p>{{#str}}token_copy_warning, local_servicemanager{{/str}}</p>
            <hr>
            <div class="input-group">
                <input type="text" class="form-control sm-mono" value="{{newtoken}}" readonly id="new-token-value" aria-label="{{#str}}current_token, local_servicemanager{{/str}}">
                <div class="input-group-append">
                    <button type="button" class="btn btn-outline-success" data-copy-target="#new-token-value"><i class="fa-solid fa-copy sm-icon-gap" aria-hidden="true"></i>{{#str}}copy, local_servicemanager{{/str}}</button>
                </div>
            </div>
        </div>
    {{/hasnewtoken}}

    <header class="sm-page-header">
        <div class="sm-page-title">
            <div class="sm-badges-row">
                <h2 class="sm-flush">{{schema.name}}</h2>
                <span class="sm-badge tone-{{schema.tone}}"><i class="fa-solid fa-{{schema.icon}} sm-icon-gap" aria-hidden="true"></i>{{schema.statuslabel}}</span>
                {{^ishistory}}<span class="sm-badge tone-secondary" data-region="disabled-badge"{{#schema.enabled}} hidden{{/schema.enabled}}>{{#str}}disabled, local_servicemanager{{/str}}</span>{{/ishistory}}
            </div>
            <p class="sm-flush"><span class="sm-id-chip" title="{{#str}}schema_id, local_servicemanager{{/str}}"><i class="fa-solid fa-fingerprint sm-icon-gap" aria-hidden="true"></i>{{schema.schemaid}}</span></p>
        </div>
        {{#hasws}}
        <span class="sm-badges-row" data-region="ws-status">
            <span class="sm-badge tone-{{ws.tone}}"><i class="fa-solid fa-{{ws.icon}} sm-icon-gap" aria-hidden="true"></i>{{#str}}tile_services, local_servicemanager{{/str}}: {{ws.label}}</span>
            {{#ws.protocols}}
                <span class="sm-protocol {{state}}" title="{{label}}">
                    <i class="fa-solid fa-{{icon}} sm-icon-gap" aria-hidden="true"></i>{{fullname}}
                    <span class="sr-only visually-hidden"> {{label}}</span>
                </span>
            {{/ws.protocols}}
            {{#ws.fixurl}}
                <a href="{{ws.fixurl}}" class="btn sm-pill compact tone-{{ws.tone}}" data-region="ws-fix">
                    <i class="fa-solid fa-power-off sm-icon-gap" aria-hidden="true"></i>{{ws.fixlabel}}
                </a>
            {{/ws.fixurl}}
            {{#canmanage}}{{#ws.protocolsurl}}
                <a href="{{ws.protocolsurl}}" class="btn sm-pill compact" title="{{#str}}ws_manage_protocols_link, local_servicemanager{{/str}}">
                    <i class="fa-solid fa-gear sm-icon-gap" aria-hidden="true"></i>{{#str}}tile_manage, local_servicemanager{{/str}}
                </a>
            {{/ws.protocolsurl}}{{/canmanage}}
        </span>
        {{/hasws}}
    </header>

    <div class="row">
        <div class="col-lg-8">
            <section class="card sm-panel" data-region="details">
                <header class="card-header sm-panel-head">
                    <h3 class="sm-panel-title"><span class="sm-panel-icon sm-muted"><i class="fa-solid fa-circle-info sm-icon-gap" aria-hidden="true"></i></span>{{#str}}schema_information, local_servicemanager{{/str}}</h3>
                    {{^ishistory}}
                        <div class="sm-group" role="group" aria-label="{{#str}}actions, moodle{{/str}}">
                            {{#canmanage}}
                                <a href="{{urls.edit}}" class="btn sm-pill icon-only compact" title="{{#str}}action_edit, local_servicemanager{{/str}}">
                                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}action_edit, local_servicemanager{{/str}}</span>
                                </a>
                                <a href="{{urls.history}}" class="btn sm-pill icon-only compact tone-primary" title="{{#str}}version_history, local_servicemanager{{/str}}">
                                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}version_history, local_servicemanager{{/str}}</span>
                                </a>
                            {{/canmanage}}
                            <a href="{{urls.export}}" class="btn sm-pill icon-only compact tone-info" title="{{#str}}action_export, local_servicemanager{{/str}}">
                                <i class="fa-solid fa-download" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}action_export, local_servicemanager{{/str}}</span>
                            </a>
                            {{#canmanage}}
                                <button type="button" class="btn sm-pill icon-only compact {{toggle.tone}}" data-action="toggle-schema" data-region="toggle-schema"
                                        title="{{toggle.label}}">
                                    <i class="fa-solid fa-{{toggle.icon}}" aria-hidden="true"></i><span class="sr-only visually-hidden">{{toggle.label}}</span>
                                </button>
                                <a href="{{urls.delete}}" class="btn sm-pill icon-only compact tone-danger" title="{{#str}}action_delete, local_servicemanager{{/str}}">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}action_delete, local_servicemanager{{/str}}</span>
                                </a>
                            {{/canmanage}}
                        </div>
                    {{/ishistory}}
                </header>
                <div class="card-body">
                    {{#schema.description}}<p>{{schema.description}}</p>{{/schema.description}}
                    <dl class="sm-facts-row sm-flush">
                        <div class="sm-fact"><dt>{{#str}}schema_version, local_servicemanager{{/str}}</dt><dd>{{schema.version}}</dd></div>
                        {{#schema.maintainer}}<div class="sm-fact"><dt>{{#str}}schema_maintainer, local_servicemanager{{/str}}</dt><dd>{{schema.maintainer}}</dd></div>{{/schema.maintainer}}
                        <div class="sm-fact"><dt>{{#str}}schema_created, local_servicemanager{{/str}}</dt><dd>{{schema.created}}</dd></div>
                        <div class="sm-fact"><dt>{{#str}}schema_modified, local_servicemanager{{/str}}</dt><dd>{{schema.modified}}</dd></div>
                        {{^ishistory}}
                            <div class="sm-fact"><dt>{{#str}}schema_enabled, local_servicemanager{{/str}}</dt>
                            <dd><span class="sm-badge tone-{{#schema.enabled}}success{{/schema.enabled}}{{^schema.enabled}}secondary{{/schema.enabled}}" data-region="enabled-badge">{{#schema.enabled}}{{#str}}yes{{/str}}{{/schema.enabled}}{{^schema.enabled}}{{#str}}no{{/str}}{{/schema.enabled}}</span></dd></div>
                        {{/ishistory}}
                    </dl>
                </div>
            </section>

            {{#hasfunctions}}
                <section class="card sm-panel" data-region="functions">
                    <header class="card-header sm-panel-head">
                        <h3 class="sm-panel-title"><span class="sm-panel-icon sm-muted"><i class="fa-solid fa-code sm-icon-gap" aria-hidden="true"></i></span>{{functionstitle}}<span class="sm-count-badge">{{functionscount}}</span></h3>
                        {{#missing}}<span class="sm-badge tone-danger">{{missinglabel}}</span>{{/missing}}
                    </header>
                    {{#searchable}}
                        <div class="sm-panel-tools">
                            <div class="input-group sm-search">
                                <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                                <input type="search" id="sm-functions-search" class="form-control" autocomplete="off"
                                       placeholder="{{#str}}functions_search, local_servicemanager{{/str}}" aria-label="{{#str}}functions_search, local_servicemanager{{/str}}">
                            </div>
                        </div>
                    {{/searchable}}
                    <ul class="list-group list-group-flush sm-functions">
                        {{#functions}}
                            <li class="list-group-item sm-function{{^exists}} missing{{/exists}}" data-region="function" data-search="{{search}}">
                                <span class="sm-function-icon{{^exists}} sm-text-danger{{/exists}}{{#exists}} sm-muted{{/exists}}"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i></span>
                                <div class="sm-grow sm-function-body">
                                    <div class="sm-badges-row">
                                        <span class="sm-fn">{{name}}</span>
                                        {{#typelabel}}<span class="sm-badge">{{typelabel}}</span>{{/typelabel}}
                                        {{#critical}}<span class="sm-badge">{{#str}}function_critical, local_servicemanager{{/str}}</span>{{/critical}}
                                        {{^exists}}<span class="sm-badge tone-danger">{{#str}}function_missing, local_servicemanager{{/str}}</span>{{/exists}}
                                    </div>
                                    {{#description}}<div class="sm-muted small">{{description}}</div>{{/description}}
                                </div>
                                {{#hascapabilities}}
                                    <button type="button" class="btn sm-pill tone-primary compact" data-action="show-capabilities"
                                            data-name="{{name}}" data-description="{{description}}" data-capabilities="{{capabilitiesjson}}"
                                            title="{{#str}}function_capabilities_view, local_servicemanager{{/str}}">
                                        <i class="fa-solid fa-shield-halved sm-icon-gap" aria-hidden="true"></i>{{capabilitiescount}}
                                    </button>
                                {{/hascapabilities}}
                            </li>
                        {{/functions}}
                    </ul>
                    <p class="sm-muted sm-center sm-block" data-region="functions-empty" hidden>{{#str}}no_schemas_filtered, local_servicemanager{{/str}}</p>
                </section>
            {{/hasfunctions}}

            {{#hasresources}}
                <section class="card sm-panel" data-region="resources">
                    <header class="card-header sm-panel-head">
                        <h3 class="sm-panel-title"><span class="sm-panel-icon sm-muted"><i class="fa-solid fa-server sm-icon-gap" aria-hidden="true"></i></span>{{#str}}provisioned_resources, local_servicemanager{{/str}}</h3>
                    </header>
                    <ul class="list-group list-group-flush">
                        {{#resources}}
                            <li class="list-group-item sm-resource">
                                <span class="sm-resource-icon sm-muted"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i></span>
                                <div class="sm-grow sm-resource-body">
                                    <div class="sm-muted small sm-upper">{{label}}</div>
                                    <a href="{{url}}" target="_blank" rel="noreferrer">{{name}}</a>
                                </div>
                                <span class="sm-id-chip compact"><i class="fa-solid fa-fingerprint sm-icon-gap" aria-hidden="true"></i>{{detail}}</span>
                            </li>
                        {{/resources}}
                    </ul>
                </section>
            {{/hasresources}}

            {{#health.hasany}}
                <section class="card sm-panel" data-region="health">
                    <header class="card-header sm-panel-head">
                        <h3 class="sm-panel-title"><span class="sm-panel-icon sm-muted"><i class="fa-solid fa-heart-pulse sm-icon-gap" aria-hidden="true"></i></span>{{#str}}healthcheck_task, local_servicemanager{{/str}}<span class="sm-count-badge">{{health.total}}</span></h3>
                        <a class="btn sm-pill compact tone-primary" href="{{health.url}}">{{#str}}health_view_all, local_servicemanager{{/str}}<i class="fa-solid fa-arrow-right sm-gap-left" aria-hidden="true"></i></a>
                    </header>
                    <div class="card-body">
                        {{#health.latest}}
                            <div class="sm-health-latest">
                                <span class="sm-muted small sm-upper">{{#str}}health_latest, local_servicemanager{{/str}}</span>
                                <span class="sm-badge tone-{{tone}}">{{statuslabel}}</span>
                                <span class="sm-muted">{{time}}</span>
                            </div>
                            <ul class="sm-health-messages">{{#messages}}<li>{{text}}</li>{{/messages}}</ul>
                        {{/health.latest}}
                        <div class="sm-health-counts">
                            {{#health.counts}}<span class="sm-badge tone-{{tone}}">{{label}}<span class="sm-gap-left">{{count}}</span></span>{{/health.counts}}
                        </div>
                    </div>
                </section>
            {{/health.hasany}}
        </div>

        <div class="col-lg-4">
            <section class="card sm-panel" data-region="access">
                <header class="card-header sm-panel-head">
                    <h3 class="sm-panel-title"><span class="sm-panel-icon sm-muted"><i class="fa-solid fa-shield-halved sm-icon-gap" aria-hidden="true"></i></span>{{#str}}guided_access, local_servicemanager{{/str}}</h3>
                </header>
                <div class="card-body">
                    <dl class="sm-facts sm-flush">
                        {{#access.showfiles}}
                            <dt>{{#str}}tile_token, local_servicemanager{{/str}}</dt>
                            <dd>
                                <span class="sm-badge tone-{{tokenbadge.tone}}" data-region="token-badge">{{tokenbadge.label}}</span>
                                {{#canmanage}}
                                    <button type="button" class="btn sm-pill icon-only compact sm-gap-left" data-action="make-token" data-region="make-token" title="{{tokenbutton.label}}">
                                        <i class="fa-solid fa-{{tokenbutton.icon}}" aria-hidden="true"></i><span class="sr-only visually-hidden">{{tokenbutton.label}}</span>
                                    </button>
                                {{/canmanage}}
                                <div class="sm-fresh-token" data-region="fresh-token" hidden>
                                    <code class="sm-token-value" id="sm-fresh-token-value"></code>
                                    <button type="button" class="btn sm-pill icon-only compact" data-copy-target="#sm-fresh-token-value" title="{{#str}}copy, local_servicemanager{{/str}}">
                                        <i class="fa-solid fa-copy" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}copy, local_servicemanager{{/str}}</span>
                                    </button>
                                    <div class="small sm-muted">{{#str}}token_shown_once, local_servicemanager{{/str}}</div>
                                </div>
                            </dd>
                            <dt>{{#str}}req_file_access, local_servicemanager{{/str}}</dt>
                            <dd class="sm-badges-row">
                                {{#access.files}}<span class="sm-badge tone-{{tone}}" title="{{title}}"><i class="fa-solid fa-{{icon}} sm-icon-gap" aria-hidden="true"></i>{{label}}</span>{{/access.files}}
                            </dd>
                        {{/access.showfiles}}
                        {{#access.hasplugins}}
                            <dt>{{#str}}req_plugins, local_servicemanager{{/str}}</dt>
                            <dd>
                                {{#access.plugins}}
                                    <div>
                                        <span class="{{#installed}}sm-text-success{{/installed}}{{^installed}}sm-text-warning{{/installed}}"><i class="fa-solid fa-{{#installed}}circle-check{{/installed}}{{^installed}}triangle-exclamation{{/installed}} sm-icon-gap" aria-hidden="true"></i></span>
                                        <span class="sm-fn">{{name}}</span>
                                        {{^installed}}<small class="sm-muted">{{#str}}function_missing, local_servicemanager{{/str}}</small>{{/installed}}
                                    </div>
                                {{/access.plugins}}
                            </dd>
                        {{/access.hasplugins}}
                        {{#access.hascapabilities}}
                            <dt class="sm-fact-wide">{{#str}}extra_capabilities, local_servicemanager{{/str}}</dt>
                            <dd class="sm-fact-wide">
                                <div class="sm-chip-row" data-region="chip-block" data-title="{{#str}}extra_capabilities, local_servicemanager{{/str}}">
                                    {{#access.capabilities}}<code class="sm-code-chip" data-chip title="{{name}}" {{hiddenattr}}><span class="sm-code-chip-plugin">{{plugin}}</span>{{#capability}}<span>:{{capability}}</span>{{/capability}}</code>{{/access.capabilities}}
                                    {{#access.hasmorecapabilities}}<button type="button" class="sm-role-more" data-action="chips-all" title="{{access.morecapabilities}}">+{{access.morecapabilitiescount}}<span class="sr-only visually-hidden"> {{access.morecapabilities}}</span></button>{{/access.hasmorecapabilities}}
                                </div>
                            </dd>
                        {{/access.hascapabilities}}
                    </dl>
                </div>
            </section>

            {{#role.visible}}
                <section class="card sm-panel" data-region="role">
                    <header class="card-header sm-panel-head">
                        <h3 class="sm-panel-title"><span class="sm-panel-icon sm-muted"><i class="fa-solid fa-user-shield sm-icon-gap" aria-hidden="true"></i></span>{{#str}}role_panel_title, local_servicemanager{{/str}}</h3>
                    </header>
                    <div class="card-body">
                        <div class="sm-role-grid">
                            {{#role.rows}}
                                <section class="sm-role-block" data-region="role-block">
                                    <h4 class="sm-role-label">{{label}}<span class="sm-role-count">{{count}}</span></h4>
                                    <div class="sm-chip-row" data-region="chip-block" data-title="{{label}}">
                                        {{#names}}<span class="sm-role-chip tone-{{tone}}" data-chip {{hiddenattr}}>{{name}}</span>{{/names}}
                                        {{#hasmore}}<button type="button" class="sm-role-more" data-action="chips-all" title="{{morelabel}}">+{{morecount}}<span class="sr-only visually-hidden"> {{morelabel}}</span></button>{{/hasmore}}
                                    </div>
                                </section>
                            {{/role.rows}}
                        </div>
                    </div>
                </section>
            {{/role.visible}}
        </div>
    </div>
</div>
{{#js}}
require(['local_servicemanager/schema'], function(schema) {
    schema.init();
});
{{/js}}
