{{!
    @template local_servicemanager/dashboard

    The dashboard: the state of the web services, the health of the schemas, the schemas and what can be done with them.

    Context variables required for this template:
    * canmanage - Whether the person can change schemas
    * sesskey - Session key for the bulk actions
    * hasschemas - Whether there is any schema
    * schemas - The schemas
    * ws - State of the web services
    * total - Number of schemas
    * perpage - Sizes of page
    * urls - Places the actions lead to

    Example context (json):
    {
        "canmanage": true,
        "sesskey": "abc",
        "hasschemas": false,
        "schemas": [],
        "truncated": false,
        "ws": {"tone": "success", "icon": "plug-circle-check", "label": "Operational", "protocols": [], "healthy": 0, "warning": 0, "critical": 0},
        "total": 0,
        "totallabel": "Schemas",
        "perpage": [{"size": 10, "first": true}],
        "urls": {"create": "#", "import": "#", "exportall": "#", "bulk": "#", "documentation": "#", "wiki": "#", "moodledocs": "#"}
    }
}}
<div class="servicemanager-dashboard{{#legacyicons}} sm-fa4{{/legacyicons}}" data-region="servicemanager-dashboard" data-bulk-url="{{urls.bulk}}" data-sesskey="{{sesskey}}">
    <header class="sm-page-header">
        <h2 class="sm-page-title">{{#str}}dashboard, local_servicemanager{{/str}}</h2>
        <span class="sm-badges-row" data-region="ws-status">
            <span class="sm-badge tone-{{ws.tone}}"><i class="fa-solid fa-{{ws.icon}} sm-icon-gap" aria-hidden="true"></i>{{#str}}tile_services, local_servicemanager{{/str}}: {{ws.label}}</span>
            {{#ws.protocols}}
                <span class="sm-protocol {{#enabled}}on{{/enabled}}{{^enabled}}off{{/enabled}}" title="{{label}}">
                    <i class="fa-solid fa-{{#enabled}}circle-check{{/enabled}}{{^enabled}}circle-minus{{/enabled}} sm-icon-gap" aria-hidden="true"></i>{{name}}
                    <span class="sr-only visually-hidden"> {{label}}</span>
                </span>
            {{/ws.protocols}}
            {{#canmanage}}{{#ws.protocolsurl}}
                <a href="{{ws.protocolsurl}}" class="btn sm-pill compact" title="{{#str}}ws_manage_protocols_link, local_servicemanager{{/str}}">
                    <i class="fa-solid fa-gear sm-icon-gap" aria-hidden="true"></i>{{#str}}tile_manage, local_servicemanager{{/str}}
                </a>
            {{/ws.protocolsurl}}{{/canmanage}}
        </span>
    </header>

    {{^hasschemas}}
        <div class="card sm-empty" data-region="empty-state">
            <div class="card-body">
                <div class="sm-empty-icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></div>
                <h3>{{#str}}empty_title, local_servicemanager{{/str}}</h3>
                <p class="sm-empty-text">{{#str}}no_schemas, local_servicemanager{{/str}}</p>
                <div class="sm-actions-row">
                    {{#canmanage}}
                        <a href="{{urls.create}}" class="btn btn-primary"><i class="fa-solid fa-plus sm-icon-gap" aria-hidden="true"></i>{{#str}}new_schema, local_servicemanager{{/str}}</a>
                        <a href="{{urls.import}}" class="btn btn-outline-primary"><i class="fa-solid fa-file-import sm-icon-gap" aria-hidden="true"></i>{{#str}}import_schemas, local_servicemanager{{/str}}</a>
                    {{/canmanage}}
                    <a href="{{urls.documentation}}" class="btn btn-outline-secondary"><i class="fa-solid fa-book sm-icon-gap" aria-hidden="true"></i>{{#str}}view_documentation, local_servicemanager{{/str}}</a>
                </div>
            </div>
        </div>
    {{/hasschemas}}

    {{#hasschemas}}
        <div class="card sm-health" data-region="summary">
            <div class="card-body sm-health-body">
                <div class="sm-health-total">
                    <span class="sm-health-number" data-region="total">{{total}}</span>
                    <span class="sm-muted" data-region="total-label" data-one="{{#str}}tile_schema, local_servicemanager{{/str}}" data-many="{{#str}}tile_schemas, local_servicemanager{{/str}}">{{totallabel}}</span>
                </div>
                <div class="sm-health-bar" aria-hidden="true" data-region="health-bar"></div>
                <div class="sm-health-legend" role="group" aria-label="{{#str}}filter_status, local_servicemanager{{/str}}">
                    <button type="button" class="sm-chip sm-health-chip" data-status="healthy" aria-pressed="false">
                        <span class="sm-text-success"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
                        <strong data-region="count-healthy">{{ws.healthy}}</strong> {{#str}}status_healthy, local_servicemanager{{/str}}
                    </button>
                    <button type="button" class="sm-chip sm-health-chip" data-status="warning" aria-pressed="false">
                        <span class="sm-text-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
                        <strong data-region="count-warning">{{ws.warning}}</strong> {{#str}}status_warning, local_servicemanager{{/str}}
                    </button>
                    <button type="button" class="sm-chip sm-health-chip" data-status="critical" aria-pressed="false">
                        <span class="sm-text-danger"><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i></span>
                        <strong data-region="count-critical">{{ws.critical}}</strong> {{#str}}status_critical, local_servicemanager{{/str}}
                    </button>
                </div>
            </div>
        </div>

        <div class="sm-toolbar">
            <div class="input-group sm-search">
                <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                <input type="search" id="sm-search" name="q" class="form-control" autocomplete="off"
                       placeholder="{{#str}}filter_name, local_servicemanager{{/str}}" aria-label="{{#str}}filter_name, local_servicemanager{{/str}}">
                <button type="button" class="btn btn-outline-secondary" data-action="clear-search" hidden title="{{#str}}filter_clear, local_servicemanager{{/str}}">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}filter_clear, local_servicemanager{{/str}}</span>
                </button>
            </div>
            <div class="dropdown sm-filter" data-region="filters">
                <button class="btn btn-outline-secondary" type="button" data-sm-menu aria-haspopup="true" aria-expanded="false">
                    <i class="fa-solid fa-sliders sm-icon-gap" aria-hidden="true"></i>{{#str}}filters, local_servicemanager{{/str}}
                    <span class="sm-count-badge" data-region="filters-count" hidden>0</span>
                </button>
                <div class="dropdown-menu dropdown-menu-right dropdown-menu-end sm-filter-menu">
                    <div class="sm-field">
                        <label for="sm-from" class="sm-label">{{#str}}filter_date_from, local_servicemanager{{/str}}</label>
                        <input type="date" id="sm-from" class="form-control">
                    </div>
                    <div class="sm-field">
                        <label for="sm-to" class="sm-label">{{#str}}filter_date_to, local_servicemanager{{/str}}</label>
                        <input type="date" id="sm-to" class="form-control">
                    </div>
                    <div class="sm-filter-title">{{#str}}filter_per_page, local_servicemanager{{/str}}</div>
                    <div class="sm-chips" role="group" aria-label="{{#str}}filter_per_page, local_servicemanager{{/str}}">
                        {{#perpage}}
                            <button type="button" class="sm-chip{{#first}} active{{/first}}" data-perpage="{{size}}" aria-pressed="{{#first}}true{{/first}}{{^first}}false{{/first}}">{{size}}</button>
                        {{/perpage}}
                    </div>
                    <button type="button" class="btn btn-link sm-reset" data-action="reset-filters" disabled>
                        <i class="fa-solid fa-rotate-left sm-icon-gap" aria-hidden="true"></i>{{#str}}filter_clear, local_servicemanager{{/str}}
                    </button>
                </div>
            </div>
            <div class="sm-toolbar-actions">
                <div class="sm-group" role="group" aria-label="{{#str}}actions, moodle{{/str}}">
                    {{#canmanage}}
                        <a href="{{urls.create}}" class="btn sm-pill icon-only solid tone-primary" title="{{#str}}new_schema, local_servicemanager{{/str}}">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}new_schema, local_servicemanager{{/str}}</span>
                        </a>
                        <a href="{{urls.import}}" class="btn sm-pill icon-only tone-success" title="{{#str}}import_schemas, local_servicemanager{{/str}}">
                            <i class="fa-solid fa-file-import" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}import_schemas, local_servicemanager{{/str}}</span>
                        </a>
                    {{/canmanage}}
                    <a href="{{urls.exportall}}" class="btn sm-pill icon-only tone-info" title="{{#str}}export_all, local_servicemanager{{/str}}">
                        <i class="fa-solid fa-file-zipper" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}export_all, local_servicemanager{{/str}}</span>
                    </a>
                    <div class="dropdown sm-action-menu">
                        <button type="button" class="btn sm-pill has-caret" data-sm-menu aria-haspopup="true" aria-expanded="false" title="{{#str}}docs_menu, local_servicemanager{{/str}}">
                            <i class="fa-solid fa-book" aria-hidden="true"></i><i class="fa-solid fa-chevron-down sm-caret" aria-hidden="true"></i>
                            <span class="sr-only visually-hidden">{{#str}}docs_menu, local_servicemanager{{/str}}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right dropdown-menu-end sm-row-menu">
                            <li><a class="dropdown-item" href="{{urls.documentation}}"><i class="fa-solid fa-file-lines sm-icon-gap" aria-hidden="true"></i>{{#str}}docs_schema_reference, local_servicemanager{{/str}}</a></li>
                            <li><a class="dropdown-item" href="{{urls.wiki}}" target="_blank" rel="noreferrer"><i class="fa-solid fa-book-open sm-icon-gap" aria-hidden="true"></i>{{#str}}docs_plugin_wiki, local_servicemanager{{/str}}</a></li>
                            <li><a class="dropdown-item" href="{{urls.moodledocs}}" target="_blank" rel="noreferrer"><i class="fa-solid fa-life-ring sm-icon-gap" aria-hidden="true"></i>{{#str}}docs_moodle, local_servicemanager{{/str}}</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="card sm-table-card" data-region="schema-table">
            <div class="table-responsive">
                <table class="table sm-table">
                    <thead>
                        <tr>
                            {{#canmanage}}
                                <th class="sm-check-cell">
                                    <input type="checkbox" id="sm-select-all">
                                    <label for="sm-select-all" class="sr-only visually-hidden">{{#str}}select_all, local_servicemanager{{/str}}</label>
                                </th>
                            {{/canmanage}}
                            <th>{{#str}}schema_name, local_servicemanager{{/str}}</th>
                            <th>{{#str}}schema_version, local_servicemanager{{/str}}</th>
                            <th>{{#str}}status, moodle{{/str}}</th>
                            <th class="sm-hide-small">{{#str}}schema_modified, local_servicemanager{{/str}}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#schemas}}
                            <tr data-region="schema-row" data-id="{{id}}" data-status="{{status}}" data-enabled="{{#enabled}}1{{/enabled}}{{^enabled}}0{{/enabled}}"
                                data-modified="{{modifiedat}}" data-text="{{name}} {{schemaid}} {{version}}"{{#hidden}} hidden{{/hidden}}>
                                {{#canmanage}}
                                    <td class="sm-check-cell">
                                        <input type="checkbox" id="schema-{{id}}" value="{{id}}" data-region="schema-check">
                                        <label for="schema-{{id}}" class="sr-only visually-hidden">{{name}}</label>
                                    </td>
                                {{/canmanage}}
                                <td>
                                    <a href="{{viewurl}}" class="sm-name">{{name}}</a>
                                    {{^enabled}}<span class="sm-badge tone-secondary sm-gap-left">{{#str}}disabled, local_servicemanager{{/str}}</span>{{/enabled}}
                                    <div><code class="small">{{schemaid}}</code></div>
                                </td>
                                <td>{{version}}</td>
                                <td><span class="sm-badge tone-{{tone}}">{{statuslabel}}</span></td>
                                <td class="sm-hide-small sm-muted">{{modified}}</td>
                                <td class="sm-actions-cell">
                                    <div class="sm-group" role="group">
                                        <a href="{{viewurl}}" class="btn sm-pill icon-only compact tone-primary" title="{{#str}}action_view, local_servicemanager{{/str}}">
                                            <i class="fa-solid fa-eye" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}action_view, local_servicemanager{{/str}}</span>
                                        </a>
                                        {{#canmanage}}
                                            <a href="{{editurl}}" class="btn sm-pill icon-only compact" title="{{#str}}action_edit, local_servicemanager{{/str}}">
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}action_edit, local_servicemanager{{/str}}</span>
                                            </a>
                                            <a href="{{historyurl}}" class="btn sm-pill icon-only compact tone-warning" title="{{#str}}version_history, local_servicemanager{{/str}}">
                                                <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}version_history, local_servicemanager{{/str}}</span>
                                            </a>
                                        {{/canmanage}}
                                        <div class="dropdown sm-action-menu">
                                            <button type="button" class="btn sm-pill icon-only compact" data-sm-menu aria-haspopup="true" aria-expanded="false" title="{{#str}}row_more, local_servicemanager{{/str}}">
                                                <i class="fa-solid fa-ellipsis" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}row_more, local_servicemanager{{/str}}</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-right dropdown-menu-end sm-row-menu">
                                                <li><a class="dropdown-item" href="{{exporturl}}"><i class="fa-solid fa-download sm-icon-gap" aria-hidden="true"></i>{{#str}}action_export, local_servicemanager{{/str}}</a></li>
                                                {{#canmanage}}
                                                    <li><button type="button" class="dropdown-item" data-action="toggle-one">
                                                        <i class="fa-solid fa-{{#enabled}}toggle-off{{/enabled}}{{^enabled}}toggle-on{{/enabled}} sm-icon-gap" aria-hidden="true"></i>{{#enabled}}{{#str}}bulk_disable, local_servicemanager{{/str}}{{/enabled}}{{^enabled}}{{#str}}bulk_enable, local_servicemanager{{/str}}{{/enabled}}
                                                    </button></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><a class="dropdown-item sm-danger" href="{{deleteurl}}"><i class="fa-solid fa-trash sm-icon-gap" aria-hidden="true"></i>{{#str}}action_delete, local_servicemanager{{/str}}</a></li>
                                                {{/canmanage}}
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {{/schemas}}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card sm-empty" data-region="empty-state" hidden>
            <div class="card-body">
                <div class="sm-empty-icon"><i class="fa-solid fa-filter-circle-xmark" aria-hidden="true"></i></div>
                <h3>{{#str}}empty_filtered_title, local_servicemanager{{/str}}</h3>
                <p class="sm-empty-text">{{#str}}no_schemas_filtered, local_servicemanager{{/str}}</p>
                <button type="button" class="btn btn-secondary" data-action="reset-all">
                    <i class="fa-solid fa-xmark sm-icon-gap" aria-hidden="true"></i>{{#str}}filter_clear, local_servicemanager{{/str}}
                </button>
            </div>
        </div>

        <nav class="servicemanager-pagination" data-region="pagination" hidden aria-label="{{#str}}pagination_aria_label, local_servicemanager{{/str}}">
            <ul class="pagination justify-content-center"></ul>
            <div class="sm-muted small sm-center" data-region="page-info"></div>
        </nav>
        {{#truncated}}<p class="sm-muted small sm-center">{{truncatedtext}}</p>{{/truncated}}

        {{#canmanage}}
            <div class="sm-floating" data-region="bulk-actions" role="status" hidden>
                <span class="sm-floating-count">
                    <span><strong data-region="selected-count">0</strong> {{#str}}selected, local_servicemanager{{/str}}</span>
                    <button type="button" class="sm-floating-clear" data-action="clear-selection" title="{{#str}}compare_clear, local_servicemanager{{/str}}">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}}compare_clear, local_servicemanager{{/str}}</span>
                    </button>
                </span>
                <div class="sm-floating-actions" role="group" aria-label="{{#str}}actions, moodle{{/str}}">
                    <button type="button" class="btn sm-pill tone-success" data-bulk="enable"><i class="fa-solid fa-toggle-on sm-icon-gap" aria-hidden="true"></i>{{#str}}bulk_enable, local_servicemanager{{/str}}</button>
                    <button type="button" class="btn sm-pill tone-warning" data-bulk="disable"><i class="fa-solid fa-toggle-off sm-icon-gap" aria-hidden="true"></i>{{#str}}bulk_disable, local_servicemanager{{/str}}</button>
                    <button type="button" class="btn sm-pill tone-info" data-bulk="export"><i class="fa-solid fa-download sm-icon-gap" aria-hidden="true"></i>{{#str}}bulk_export, local_servicemanager{{/str}}</button>
                    <button type="button" class="btn sm-pill tone-danger" data-bulk="delete"><i class="fa-solid fa-trash sm-icon-gap" aria-hidden="true"></i>{{#str}}bulk_delete, local_servicemanager{{/str}}</button>
                </div>
            </div>
        {{/canmanage}}
    {{/hasschemas}}
</div>
{{#js}}
require(['local_servicemanager/dashboard'], function(dashboard) {
    dashboard.init();
});
{{/js}}
