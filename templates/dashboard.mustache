{{!
    @template local_servicemanager/dashboard

    The dashboard, drawn with the Didactika design system as the lists of Delegate account: the head of the page with its actions,
    the summary of the schemas and of the web services, and the list of the schemas with its search, its filters (status and date),
    its pager and the floating bar of what is chosen. The script filters and pages the rows without asking the server again.

    Context variables required for this template:
    * canmanage - Whether the person can change schemas
    * sesskey - Session key for the bulk actions
    * hasschemas - Whether there is any schema
    * schemas - The schemas
    * statuses - The statuses a schema can have
    * ws - State of the web services
    * total - Number of schemas
    * urls - Places the actions lead to

    Example context (json):
    {
        "canmanage": true,
        "sesskey": "abc",
        "hasschemas": false,
        "schemas": [],
        "statuses": [{"key": "healthy", "label": "Healthy", "tone": "success", "count": 0, "share": 0}],
        "truncated": false,
        "ws": {"tone": "success", "label": "Operational", "protocols": [], "canconfigure": false, "enabled": true},
        "total": 0,
        "totallabel": "Schemas",
        "urls": {"create": "#", "import": "#", "exportall": "#", "bulk": "#", "documentation": "#", "manual": "#", "moodledocs": "#"}
    }
}}
<div class="lsm servicemanager-dashboard" data-region="servicemanager-dashboard" data-bulk-url="{{urls.bulk}}" data-sesskey="{{sesskey}}">
    <header class="dd-page-header mb-3">
        <div class="dd-page-header-row">
            <div class="dd-page-header-main">
                <span class="dd-tile dd-tile-lg">{{#pix}}plug, local_servicemanager{{/pix}}</span>
                <p class="dd-page-subtitle">{{#str}}dashboard_subtitle, local_servicemanager{{/str}}</p>
            </div>
            <div class="dd-page-actions">
                <div class="dropdown">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-sm-menu aria-haspopup="true" aria-expanded="false">
                        {{#pix}}docs, core{{/pix}} {{#str}}docs_menu, local_servicemanager{{/str}}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{urls.documentation}}">{{#str}}docs_schema_reference, local_servicemanager{{/str}}</a></li>
                        <li><a class="dropdown-item" href="{{urls.manual}}" target="_blank" rel="noreferrer">{{#str}}docs_plugin_manual, local_servicemanager{{/str}} {{#pix}}i/externallink, core{{/pix}}</a></li>
                        <li><a class="dropdown-item" href="{{urls.moodledocs}}" target="_blank" rel="noreferrer">{{#str}}docs_moodle, local_servicemanager{{/str}} {{#pix}}i/externallink, core{{/pix}}</a></li>
                    </ul>
                </div>
                <a class="btn btn-outline-secondary" href="{{urls.exportall}}">{{#pix}}t/download, core{{/pix}} {{#str}}export_all, local_servicemanager{{/str}}</a>
                {{#canmanage}}
                    <a class="btn btn-outline-secondary" href="{{urls.import}}">{{#pix}}i/import, core{{/pix}} {{#str}}import_schemas, local_servicemanager{{/str}}</a>
                    <a class="btn btn-primary" href="{{urls.create}}">{{#pix}}t/add, core{{/pix}} {{#str}}new_schema, local_servicemanager{{/str}}</a>
                {{/canmanage}}
            </div>
        </div>
    </header>

    <div class="card mb-3" data-region="summary">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center">
                <p class="mb-0 mr-3 me-3"><span class="h3 font-weight-bold fw-bold mr-1 me-1" data-region="total">{{total}}</span>
                    <span class="text-muted">{{totallabel}}</span></p>
                <div class="progress flex-grow-1 mr-3 me-3" role="img" aria-label="{{#statuses}}{{count}} {{label}} {{/statuses}}">
                    {{#statuses}}<div class="progress-bar bg-{{tone}}" style="width: {{share}}%"></div>{{/statuses}}
                </div>
                <ul class="list-inline mb-0">
                    {{#statuses}}
                        <li class="list-inline-item"><span class="badge badge-soft rounded-pill text-bg-{{tone}}">{{count}} {{label}}</span></li>
                    {{/statuses}}
                </ul>
            </div>
            {{#ws}}
                <div class="d-flex flex-wrap align-items-center border-top pt-3 mt-3" data-region="ws-status">
                    <span class="badge badge-soft badge-dot rounded-pill text-bg-{{tone}} mr-3 me-3">{{#str}}tile_services, local_servicemanager{{/str}}: {{label}}</span>
                    {{#protocols}}
                        <form method="post" action="{{toggleurl}}" class="mr-3 me-3" data-region="protocol">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="returnurl" value="{{returnurl}}">
                            <input type="hidden" name="protocol" value="{{key}}">
                            <input type="hidden" name="enable" value="{{#turnedon}}0{{/turnedon}}{{^turnedon}}1{{/turnedon}}">
                            <div class="custom-control custom-switch form-check form-switch mb-0">
                                <input type="checkbox" class="custom-control-input form-check-input" role="switch" id="lsm-protocol-{{key}}"
                                    {{#turnedon}}checked{{/turnedon}} {{^canconfigure}}disabled{{/canconfigure}} data-action="protocol">
                                <label class="custom-control-label form-check-label" for="lsm-protocol-{{key}}">{{name}}</label>
                            </div>
                        </form>
                    {{/protocols}}
                    {{#canconfigure}}
                        <div class="ml-auto ms-auto d-flex flex-wrap align-items-center">
                            <form method="post" action="{{toggleurl}}" class="mr-2 me-2" data-region="ws-toggle">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="returnurl" value="{{returnurl}}">
                                <input type="hidden" name="enable" value="{{#enabled}}0{{/enabled}}{{^enabled}}1{{/enabled}}">
                                {{#enabled}}
                                    <button type="submit" class="btn btn-outline-danger btn-sm" data-action="ws-off">{{#str}}ws_disable_services, local_servicemanager{{/str}}</button>
                                {{/enabled}}
                                {{^enabled}}
                                    <button type="submit" class="btn btn-primary btn-sm">{{#str}}ws_enable_services, local_servicemanager{{/str}}</button>
                                {{/enabled}}
                            </form>
                            {{#protocolsurl}}
                                <a href="{{protocolsurl}}" class="btn btn-outline-secondary btn-sm">{{#pix}}i/settings, core{{/pix}} {{#str}}tile_manage, local_servicemanager{{/str}}</a>
                            {{/protocolsurl}}
                        </div>
                    {{/canconfigure}}
                </div>
            {{/ws}}
        </div>
    </div>

    {{^hasschemas}}
        <div class="card">
            <div class="dd-empty" data-region="empty">
                <span class="dd-tile dd-tile-lg">{{#pix}}plug, local_servicemanager{{/pix}}</span>
                <p class="dd-empty-title">{{#str}}empty_title, local_servicemanager{{/str}}</p>
                <p class="dd-empty-text">{{#str}}no_schemas, local_servicemanager{{/str}}</p>
                {{#canmanage}}
                    <div class="d-flex flex-wrap justify-content-center">
                        <a href="{{urls.create}}" class="btn btn-primary mr-2 me-2">{{#pix}}t/add, core{{/pix}} {{#str}}new_schema, local_servicemanager{{/str}}</a>
                        <a href="{{urls.import}}" class="btn btn-outline-secondary">{{#pix}}i/import, core{{/pix}} {{#str}}import_schemas, local_servicemanager{{/str}}</a>
                    </div>
                {{/canmanage}}
            </div>
        </div>
    {{/hasschemas}}

    {{#hasschemas}}
        <div class="card">
            <div class="table-toolbar" data-region="filters">
                <div class="table-toolbar-start">
                    <div class="dd-searchbox" role="search">
                        {{#pix}}a/search, core{{/pix}}
                        <label class="sr-only visually-hidden" for="lsm-search">{{#str}}filter_name, local_servicemanager{{/str}}</label>
                        <input class="form-control" type="search" id="lsm-search" placeholder="{{#str}}filter_name, local_servicemanager{{/str}}" autocomplete="off">
                    </div>
                    <div data-region="filter-menus">
                        <div class="dd-menu dd-select-filter" data-menu="status">
                            <button type="button" class="custom-select form-select dd-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                                aria-label="{{#str}}filter_status, local_servicemanager{{/str}}"><span data-region="menu-label"
                                data-label="{{#str}}filter_status, local_servicemanager{{/str}}">{{#str}}filter_status, local_servicemanager{{/str}}</span></button>
                            <button type="button" class="dd-select-clear" data-menu-clear hidden
                                title="{{#str}}filter_clear, local_servicemanager{{/str}}: {{#str}}filter_status, local_servicemanager{{/str}}"
                                aria-label="{{#str}}filter_clear, local_servicemanager{{/str}}: {{#str}}filter_status, local_servicemanager{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                            <div class="dd-select-menu" role="group" aria-label="{{#str}}filter_status, local_servicemanager{{/str}}" hidden>
                                {{#statuses}}
                                    <label class="dropdown-item" for="lsm-status-{{key}}">
                                        <input type="checkbox" class="form-check-input" id="lsm-status-{{key}}" value="{{key}}" data-label="{{label}}">
                                        <span>{{label}}</span>
                                        <span class="dd-chip-count" data-status-count="{{key}}">{{count}}</span>
                                    </label>
                                {{/statuses}}
                            </div>
                        </div>
                        {{> local_servicemanager/date_menu }}
                        <div class="dd-menu dd-menu-end" data-menu="filters" hidden>
                            <button type="button" class="custom-select form-select dd-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                                aria-label="{{#str}}filters, local_servicemanager{{/str}}">{{#pix}}i/filter, core{{/pix}} <span data-region="menu-label"
                                data-label="{{#str}}filters, local_servicemanager{{/str}}">{{#str}}filters, local_servicemanager{{/str}}</span></button>
                            <div class="dd-select-menu" role="group" aria-label="{{#str}}filters, local_servicemanager{{/str}}" hidden>
                                <div data-region="filter-panel"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-toolbar-end">
                    <button type="button" class="btn btn-link btn-icon" data-action="reset-all" disabled
                        title="{{#str}}filters_reset, local_servicemanager{{/str}}" aria-label="{{#str}}filters_reset, local_servicemanager{{/str}}">{{#pix}}i/reload, core{{/pix}}</button>
                </div>
            </div>
            <div class="table-responsive" data-region="tablewrap">
                <table class="table" data-region="schema-table">
                    <caption class="sr-only visually-hidden">{{#str}}dashboard, local_servicemanager{{/str}}</caption>
                    <thead>
                        <tr>
                            {{#canmanage}}
                                <th scope="col" class="table-select">
                                    <input type="checkbox" class="form-check-input" id="lsm-select-all">
                                    <label for="lsm-select-all" class="sr-only visually-hidden">{{#str}}select_all, local_servicemanager{{/str}}</label>
                                </th>
                            {{/canmanage}}
                            <th scope="col">{{#str}}schema_name, local_servicemanager{{/str}}</th>
                            <th scope="col">{{#str}}schema_version, local_servicemanager{{/str}}</th>
                            <th scope="col">{{#str}}schema_status, local_servicemanager{{/str}}</th>
                            <th scope="col" class="d-none d-md-table-cell">{{#str}}schema_modified, local_servicemanager{{/str}}</th>
                            <th scope="col" class="table-actions"><span class="sr-only visually-hidden">{{#str}}actions, moodle{{/str}}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#schemas}}
                            <tr data-region="schema-row" data-id="{{id}}" data-status="{{status}}" data-enabled="{{enabledvalue}}"
                                data-modified="{{modifiedat}}" data-text="{{name}} {{schemaid}} {{version}}"{{#hidden}} hidden{{/hidden}}>
                                {{#canmanage}}
                                    <td class="table-select">
                                        <input type="checkbox" class="form-check-input" id="lsm-schema-{{id}}" value="{{id}}" data-region="schema-check">
                                        <label for="lsm-schema-{{id}}" class="sr-only visually-hidden">{{name}}</label>
                                    </td>
                                {{/canmanage}}
                                <td>
                                    <span class="d-flex flex-column">
                                        <span>
                                            <a href="{{viewurl}}" class="font-weight-bold fw-bold">{{name}}</a>
                                            {{^enabled}}<span class="badge badge-soft rounded-pill text-bg-secondary ml-2 ms-2">{{#str}}disabled, local_servicemanager{{/str}}</span>{{/enabled}}
                                        </span>
                                        <small class="text-muted">{{#pix}}fingerprint, local_servicemanager{{/pix}} {{schemaid}}</small>
                                    </span>
                                </td>
                                <td>{{version}}</td>
                                <td><span class="badge badge-soft badge-dot rounded-pill text-bg-{{tone}}">{{statuslabel}}</span></td>
                                <td class="d-none d-md-table-cell"><small class="text-muted">{{modified}}</small></td>
                                <td class="table-actions">
                                    <a class="btn btn-link btn-icon btn-sm text-primary" href="{{viewurl}}" title="{{#str}}action_view, local_servicemanager{{/str}}"
                                        aria-label="{{#str}}action_view, local_servicemanager{{/str}}: {{name}}">{{#pix}}view, local_servicemanager{{/pix}}</a>
                                    {{#canmanage}}
                                        <a class="btn btn-link btn-icon btn-sm text-primary" href="{{editurl}}" title="{{#str}}action_edit, local_servicemanager{{/str}}"
                                            aria-label="{{#str}}action_edit, local_servicemanager{{/str}}: {{name}}">{{#pix}}t/edit, core{{/pix}}</a>
                                        <a class="btn btn-link btn-icon btn-sm text-info" href="{{historyurl}}" title="{{#str}}version_history, local_servicemanager{{/str}}"
                                            aria-label="{{#str}}version_history, local_servicemanager{{/str}}: {{name}}">{{#pix}}history, local_servicemanager{{/pix}}</a>
                                    {{/canmanage}}
                                    <div class="dropdown d-inline-block">
                                        <button type="button" class="btn btn-link btn-icon btn-sm" data-sm-menu aria-haspopup="true" aria-expanded="false"
                                            title="{{#str}}row_more, local_servicemanager{{/str}}" aria-label="{{#str}}row_more, local_servicemanager{{/str}}: {{name}}">{{#pix}}i/moremenu, core{{/pix}}</button>
                                        <ul class="dropdown-menu dropdown-menu-right dropdown-menu-end">
                                            <li><a class="dropdown-item" href="{{exporturl}}">{{#pix}}t/download, core{{/pix}} {{#str}}action_export, local_servicemanager{{/str}}</a></li>
                                            {{#canmanage}}
                                                <li><button type="button" class="dropdown-item" data-action="toggle-one">{{#enabled}}{{#pix}}t/hide, core{{/pix}}{{/enabled}}{{^enabled}}{{#pix}}t/show, core{{/pix}}{{/enabled}} {{togglelabel}}</button></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item text-danger" href="{{deleteurl}}">{{#pix}}t/delete, core{{/pix}} {{#str}}action_delete, local_servicemanager{{/str}}</a></li>
                                            {{/canmanage}}
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {{/schemas}}
                    </tbody>
                </table>
                <div class="dd-empty" data-region="empty-state" hidden>
                    <span class="dd-tile dd-tile-lg">{{#pix}}a/search, core{{/pix}}</span>
                    <p class="dd-empty-text">{{#str}}no_schemas_filtered, local_servicemanager{{/str}}</p>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="reset-all">{{#str}}filters_reset, local_servicemanager{{/str}}</button>
                </div>
            </div>
            <div class="table-foot" data-region="pagination" hidden></div>
        </div>
        {{#truncated}}<p class="text-muted small text-center mt-2">{{truncatedtext}}</p>{{/truncated}}

        {{#canmanage}}
            <div class="dd-floatbar" data-region="bulk-actions" role="region" aria-label="{{#str}}actions, moodle{{/str}}" hidden>
                <span class="dd-floatbar-count" role="status" data-region="selected-count"></span>
                <div class="dd-floatbar-actions">
                    <button type="button" class="btn btn-secondary btn-tonal btn-sm" data-bulk="enable">{{#pix}}t/show, core{{/pix}} {{#str}}bulk_enable, local_servicemanager{{/str}}</button>
                    <button type="button" class="btn btn-secondary btn-tonal btn-sm" data-bulk="disable">{{#pix}}t/hide, core{{/pix}} {{#str}}bulk_disable, local_servicemanager{{/str}}</button>
                    <button type="button" class="btn btn-secondary btn-tonal btn-sm" data-bulk="export">{{#pix}}t/download, core{{/pix}} {{#str}}bulk_export, local_servicemanager{{/str}}</button>
                    <button type="button" class="btn btn-danger btn-tonal btn-sm" data-bulk="delete">{{#pix}}t/delete, core{{/pix}} {{#str}}bulk_delete, local_servicemanager{{/str}}</button>
                </div>
                <button type="button" class="dd-floatbar-clear" data-action="clear-selection"
                    title="{{#str}}clear_selection, local_servicemanager{{/str}}" aria-label="{{#str}}clear_selection, local_servicemanager{{/str}}"></button>
            </div>
        {{/canmanage}}
    {{/hasschemas}}
</div>
{{#js}}
require(['local_servicemanager/dashboard'], function(dashboard) {
    dashboard.init();
});
{{/js}}
