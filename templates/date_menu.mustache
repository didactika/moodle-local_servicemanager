{{!
    @template local_servicemanager/date_menu

    The menu of a date of the design system: the usual periods, and two days of choice that never go the wrong way round.

    Context variables required for this template:
    * datelabel - What the menu filters, which it says while nothing is chosen

    Example context (json):
    {
        "datelabel": "Last modified"
    }
}}
<div class="dd-menu dd-select-filter" data-menu="date">
    <button type="button" class="custom-select form-select dd-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
        aria-label="{{datelabel}}"><span data-region="menu-label" data-label="{{datelabel}}">{{datelabel}}</span></button>
    <button type="button" class="dd-select-clear" data-menu-clear hidden
        title="{{#str}}filter_clear, local_servicemanager{{/str}}: {{datelabel}}"
        aria-label="{{#str}}filter_clear, local_servicemanager{{/str}}: {{datelabel}}">{{#pix}}e/cancel, core{{/pix}}</button>
    <div class="dd-select-menu" role="group" aria-label="{{datelabel}}" hidden>
        <button type="button" class="dropdown-item" data-preset="today">{{#str}}filter_date_today, local_servicemanager{{/str}}</button>
        <button type="button" class="dropdown-item" data-preset="week">{{#str}}filter_date_week, local_servicemanager{{/str}}</button>
        <button type="button" class="dropdown-item" data-preset="month">{{#str}}filter_date_month, local_servicemanager{{/str}}</button>
        <button type="button" class="dropdown-item" data-preset="last30">{{#str}}filter_date_last30, local_servicemanager{{/str}}</button>
        <hr>
        <div class="dd-menu-form">
            <div class="dd-menu-dates">
                <div>
                    <label class="form-label small mb-1" for="lsm-from">{{#str}}filter_date_from, local_servicemanager{{/str}}</label>
                    <input type="date" id="lsm-from" class="form-control form-control-sm" data-date="from">
                </div>
                <div>
                    <label class="form-label small mb-1" for="lsm-to">{{#str}}filter_date_to, local_servicemanager{{/str}}</label>
                    <input type="date" id="lsm-to" class="form-control form-control-sm" data-date="to">
                </div>
            </div>
        </div>
    </div>
</div>
