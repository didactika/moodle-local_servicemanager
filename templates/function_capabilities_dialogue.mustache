{{!
    @template local_servicemanager/function_capabilities_dialogue

    The body of the dialogue that shows the capabilities of a function.

    Context variables required for this template:
    * name - The function
    * description - What it does, or nothing
    * hint - What the list is
    * items - The capabilities, each as an object with a name

    Example context (json):
    {
        "name": "core_user_get_users",
        "description": "Search for users",
        "hint": "These are the capabilities that whoever calls this function must have.",
        "items": [{"name": "moodle/user:viewdetails"}]
    }
}}
<div class="servicemanager-detail">
    <p><span class="sm-fn">{{name}}</span></p>
    {{#description}}<p class="sm-muted">{{description}}</p>{{/description}}
    <p class="small sm-muted">{{hint}}</p>
    {{> local_servicemanager/chips_rows}}
</div>
