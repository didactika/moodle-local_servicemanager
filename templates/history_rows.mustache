{{!
    @template local_servicemanager/history_rows

    The versions of a schema, as a table of the design system. The history draws it once and again when a rollback changes it.

    Context variables required for this template:
    * rows - The versions

    Example context (json):
    {
        "rows": [{"id": 1, "version": "1.0.0", "username": "Admin", "userpicture": "#", "date": "today", "reason": "", "iscurrent": true, "canrollback": false, "hidden": false, "text": "1.0.0 Admin", "at": 0, "viewurl": "#"}]
    }
}}
<table class="table" data-region="versions">
    <caption class="sr-only visually-hidden">{{#str}}version_history, local_servicemanager{{/str}}</caption>
    <thead>
        <tr>
            <th scope="col" class="table-select"><span class="sr-only visually-hidden">{{#str}}compare_select, local_servicemanager{{/str}}</span></th>
            <th scope="col">{{#str}}version, local_servicemanager{{/str}}</th>
            <th scope="col">{{#str}}history_by, local_servicemanager{{/str}}</th>
            <th scope="col" class="d-none d-md-table-cell">{{#str}}history_reason, local_servicemanager{{/str}}</th>
            <th scope="col" class="table-actions"><span class="sr-only visually-hidden">{{#str}}actions, moodle{{/str}}</span></th>
        </tr>
    </thead>
    <tbody>
    {{#rows}}
        <tr data-region="version" data-id="{{id}}" data-at="{{at}}" data-text="{{text}}" data-version="{{version}}"{{#hidden}} hidden{{/hidden}}>
            <td class="table-select">
                <input type="checkbox" id="lsm-compare-{{id}}" name="compare[]" value="{{id}}" class="form-check-input" data-region="version-check">
                <label for="lsm-compare-{{id}}" class="sr-only visually-hidden">{{#str}}compare_select, local_servicemanager{{/str}} {{version}}</label>
            </td>
            <td>
                <span class="fw-semibold">{{#pix}}branch, local_servicemanager{{/pix}} {{version}}</span>
                {{#iscurrent}}<span class="badge badge-soft rounded-pill text-bg-success ms-2">{{#str}}current, local_servicemanager{{/str}}</span>{{/iscurrent}}
            </td>
            <td>
                <span class="d-flex align-items-center gap-2">
                    <img src="{{userpicture}}" alt="" width="24" height="24" class="rounded-circle" loading="lazy">
                    <span class="d-flex flex-column">{{username}}<small class="text-muted">{{date}}</small></span>
                </span>
            </td>
            <td class="d-none d-md-table-cell"><span class="text-truncate d-block" title="{{reason}}">{{reason}}</span></td>
            <td class="table-actions">
                <button type="button" class="btn btn-link btn-icon btn-sm" data-action="show-yaml" title="{{#str}}view_yaml, local_servicemanager{{/str}}"
                    aria-label="{{#str}}view_yaml, local_servicemanager{{/str}}: {{version}}">{{#pix}}code, local_servicemanager{{/pix}}</button>
                <a href="{{viewurl}}" class="btn btn-link btn-icon btn-sm text-primary" title="{{#str}}action_view, local_servicemanager{{/str}}"
                    aria-label="{{#str}}action_view, local_servicemanager{{/str}}: {{version}}">{{#pix}}view, local_servicemanager{{/pix}}</a>
                {{#canrollback}}
                    <button type="button" class="btn btn-link btn-icon btn-sm text-warning" data-action="rollback" data-id="{{id}}" data-version="{{version}}"
                        title="{{#str}}rollback, local_servicemanager{{/str}}" aria-label="{{#str}}rollback, local_servicemanager{{/str}}: {{version}}">{{#pix}}t/reset, core{{/pix}}</button>
                {{/canrollback}}
            </td>
        </tr>
    {{/rows}}
    </tbody>
</table>
