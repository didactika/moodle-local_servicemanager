{{!
    @template local_servicemanager/chips_dialogue

    The body of the dialogue that shows every name of a list of chips, with a search when there are many. The rows are drawn by the script.

    Context variables required for this template:
    * hassearch - Whether the dialogue has a search
    * placeholder - What the search asks for
    * nonetext - What is said when the search finds nothing

    Example context (json):
    {
        "hassearch": true,
        "placeholder": "Filter by name",
        "nonetext": "Nothing matches"
    }
}}
<div class="servicemanager-detail">
    {{#hassearch}}
        <div class="sm-dialog-search">
            <input type="search" class="form-control" data-region="chips-search" placeholder="{{placeholder}}" aria-label="{{placeholder}}">
        </div>
    {{/hassearch}}
    {{> local_servicemanager/chips_rows}}
    <p class="sm-muted sm-center sm-block-small" data-region="chip-none" hidden>{{nonetext}}</p>
</div>
