{{!
    @template local_servicemanager/health_page

    The results of the health checks of a schema, narrowed to one status and a page at a time.

    Context variables required for this template:
    * backurl - Where Back leads
    * schemaname - The name of the schema
    * hasany - Whether the schema was ever checked
    * filters - The statuses, each with its count, its address and whether it is the one shown
    * hasrows, rows - The checks of the page: when, the status in words and colour, and what each found
    * showing - Which checks of how many the page shows
    * pagingbar, perpageselect - The paging bar and the choice of the size of page, as HTML

    Example context (json):
    {
        "backurl": "#",
        "schemaname": "Test Service",
        "hasany": true,
        "filters": [
            {"label": "All", "count": 2, "tone": "primary", "active": true, "url": "#"},
            {"label": "Healthy", "count": 1, "tone": "success", "active": false, "url": "#"},
            {"label": "Warning", "count": 1, "tone": "warning", "active": false, "url": "#"},
            {"label": "Critical", "count": 0, "tone": "danger", "active": false, "url": "#"}
        ],
        "hasrows": true,
        "rows": [
            {"time": "15/10/26, 21:43", "status": "healthy", "statuslabel": "Healthy", "tone": "success", "messages": [{"text": "All checks passed"}]},
            {"time": "14/10/26, 21:43", "status": "warning", "statuslabel": "Warning", "tone": "warning", "messages": [{"text": "Service: disabled"}, {"text": "Token: expired"}]}
        ],
        "showing": "Showing 1 to 2 of 2",
        "pagingbar": "",
        "perpageselect": ""
    }
}}
<div class="servicemanager-health-page{{#legacyicons}} sm-fa4{{/legacyicons}}" data-region="servicemanager-health">
    <div class="sm-block">
        <a href="{{backurl}}" class="btn btn-secondary"><i class="fa-solid fa-arrow-left sm-icon-gap" aria-hidden="true"></i>{{#str}}back, local_servicemanager{{/str}}</a>
    </div>
    <header class="sm-page-header">
        <div class="sm-page-title">
            <h2 class="sm-flush">{{#str}}health_checks, local_servicemanager{{/str}}</h2>
            <p class="sm-muted sm-flush">{{schemaname}}</p>
        </div>
    </header>

    {{^hasany}}
        <div class="card sm-empty" data-region="empty-state">
            <div class="card-body text-center py-5">
                <div class="sm-empty-icon sm-muted mb-3"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i></div>
                <p class="sm-muted mx-auto sm-empty-text">{{#str}}health_none, local_servicemanager{{/str}}</p>
            </div>
        </div>
    {{/hasany}}

    {{#hasany}}
        <div class="sm-toolbar sm-spread">
            <nav class="sm-group sm-health-filters" aria-label="{{#str}}status, moodle{{/str}}" data-region="health-filters">
                {{#filters}}
                    <a class="btn sm-pill compact tone-{{tone}}{{#active}} active{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}>{{label}}<span class="sm-count-badge">{{count}}</span></a>
                {{/filters}}
            </nav>
            <div class="sm-perpage">{{{perpageselect}}}</div>
        </div>

        <div class="card sm-panel sm-block">
            {{#hasrows}}
                <div class="table-responsive">
                    <table class="table table-sm sm-flush-table sm-health-table" data-region="health-table">
                        <thead>
                            <tr>
                                <th class="sm-time-column">{{#str}}time, moodle{{/str}}</th>
                                <th class="sm-status-column">{{#str}}status, moodle{{/str}}</th>
                                <th>{{#str}}message, moodle{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#rows}}
                                <tr data-status="{{status}}">
                                    <td class="sm-time-column">{{time}}</td>
                                    <td><span class="sm-badge tone-{{tone}}">{{statuslabel}}</span></td>
                                    <td><ul class="sm-health-messages">{{#messages}}<li>{{text}}</li>{{/messages}}</ul></td>
                                </tr>
                            {{/rows}}
                        </tbody>
                    </table>
                </div>
            {{/hasrows}}
            {{^hasrows}}
                <div class="card-body sm-muted">{{#str}}health_none_with_status, local_servicemanager{{/str}}</div>
            {{/hasrows}}
        </div>

        <div class="sm-pager">
            <span class="sm-muted" data-region="health-showing">{{showing}}</span>
            {{{pagingbar}}}
        </div>
    {{/hasany}}
</div>
