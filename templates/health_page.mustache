{{!
    @template local_servicemanager/health_page

    The results of the health checks of a schema, narrowed to one status and a page at a time.

    Context variables required for this template:
    * backurl - Where Back leads
    * schemaname - The name of the schema
    * hasany - Whether the schema was ever checked
    * filters - The statuses, each with its count, its address and whether it is the one shown
    * hasrows, rows - The checks of the page: when and how long ago, the status in words, colour and icon, and what each found
    * showing - Which checks of how many the page shows
    * pager - The foot of the list: the sizes of page that fit it, the range and the addresses of the previous and next pages

    Example context (json):
    {
        "backurl": "#",
        "schemaname": "Test Service",
        "hasany": true,
        "filters": [
            {"label": "All", "count": 2, "tone": "primary", "active": true, "url": "#"},
            {"label": "Healthy", "count": 1, "tone": "success", "active": false, "url": "#"},
            {"label": "Warning", "count": 1, "tone": "warning", "active": false, "url": "#"},
            {"label": "Critical", "count": 0, "tone": "danger", "active": false, "url": "#"}
        ],
        "hasrows": true,
        "rows": [
            {"time": "15/10/26, 21:43", "ago": "2 hours ago", "status": "healthy", "statuslabel": "Healthy", "tone": "success", "icon": "circle-check", "findings": [{"label": "", "text": "All checks passed"}]},
            {"time": "14/10/26, 21:43", "ago": "1 day ago", "status": "warning", "statuslabel": "Warning", "tone": "warning", "icon": "triangle-exclamation", "findings": [{"label": "Service:", "text": "disabled"}, {"label": "Token:", "text": "expired"}]}
        ],
        "showing": "Showing 1 to 2 of 2",
        "pager": {"formurl": "#", "id": 1, "status": "", "sizes": [{"value": 0, "label": "All", "selected": true}], "range": "1–2 of 2", "hasprev": false, "hasnext": false, "prevurl": "#", "nexturl": "#"}
    }
}}
<div class="lsm servicemanager-health-page" data-region="servicemanager-health">
    <div class="mb-3">
        <a href="{{backurl}}" class="btn btn-secondary">{{#pix}}t/left, core{{/pix}} {{#str}}back, local_servicemanager{{/str}}</a>
    </div>
    <header class="dd-page-header mb-3">
        <div>
            <h2 class="dd-page-title">{{#str}}health_checks, local_servicemanager{{/str}}</h2>
            <p class="dd-page-subtitle">{{schemaname}}</p>
        </div>
    </header>

    {{^hasany}}
        <div class="card" data-region="empty-state">
        <div class="dd-empty">
            <span class="dd-tile dd-tile-lg">{{#pix}}health, local_servicemanager{{/pix}}</span>
                <p class="dd-empty-text">{{#str}}health_none, local_servicemanager{{/str}}</p>
            </div>
        </div>
    {{/hasany}}

    {{#hasany}}
        <div class="card mb-3">
            <div class="table-toolbar">
                <nav class="dd-chips" aria-label="{{#str}}status, moodle{{/str}}" data-region="health-filters">
                    {{#filters}}
                        <a class="dd-chip" href="{{url}}" aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}"{{#active}} aria-current="true"{{/active}}>{{label}} <span class="dd-chip-count">{{count}}</span></a>
                    {{/filters}}
                </nav>
            </div>
            {{#hasrows}}
                <div class="table-responsive" data-region="tablewrap">
                    <table class="table" data-region="health-table">
                        <thead>
                            <tr>
                                <th>{{#str}}time, moodle{{/str}}</th>
                                <th>{{#str}}status, moodle{{/str}}</th>
                                <th>{{#str}}message, moodle{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#rows}}
                                <tr data-status="{{status}}">
                                    <td>
                                        <span class="d-block">{{time}}</span>
                                        <small class="d-block text-muted">{{ago}}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft rounded-pill text-bg-{{tone}}">{{{iconhtml}}}{{statuslabel}}</span>
                                    </td>
                                    <td>
                                        <ul class="list-unstyled d-grid gap-1 mb-0">
                                            {{#findings}}
                                                <li>{{{iconhtml}}}<span>{{#label}}<strong>{{label}}</strong> {{/label}}{{text}}</span></li>
                                            {{/findings}}
                                        </ul>
                                    </td>
                                </tr>
                            {{/rows}}
                        </tbody>
                    </table>
                </div>
            {{/hasrows}}
            {{^hasrows}}
                <div data-region="tablewrap">
                    <div data-region="empty-state">
            <div class="dd-empty">
                <span class="dd-tile dd-tile-lg">{{#pix}}i/filter, core{{/pix}}</span>
                            <p class="dd-empty-text">{{#str}}health_none_with_status, local_servicemanager{{/str}}</p>
                        </div>
                    </div>
                </div>
            {{/hasrows}}
            {{#pager}}
            <div class="table-foot">
                <nav class="dd-pager" aria-label="{{#str}}pagination_aria_label, local_servicemanager{{/str}}">
                    <form method="get" action="{{formurl}}" class="dd-pager-size" data-region="health-perpage">
                        <input type="hidden" name="id" value="{{id}}">
                        {{#status}}<input type="hidden" name="status" value="{{status}}">{{/status}}
                        <label for="lsm-health-perpage" class="mb-0">{{#str}}pagination_per_page, local_servicemanager{{/str}}</label>
                        <select id="lsm-health-perpage" name="perpage" class="custom-select custom-select-sm form-select form-select-sm dd-select">
                            {{#sizes}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/sizes}}
                        </select>
                    </form>
                    <div class="dd-pager-end">
                        <span class="dd-pager-range" role="status" data-region="health-showing">{{range}}</span>
                        <div class="dd-pager-arrows">
                            {{#hasprev}}<a class="btn btn-outline-secondary btn-sm btn-icon" href="{{prevurl}}" title="{{#str}}pagination_previous, local_servicemanager{{/str}}" aria-label="{{#str}}pagination_previous, local_servicemanager{{/str}}">{{#pix}}i/previous, core{{/pix}}</a>{{/hasprev}}
                            {{^hasprev}}<button type="button" class="btn btn-outline-secondary btn-sm btn-icon" disabled aria-label="{{#str}}pagination_previous, local_servicemanager{{/str}}">{{#pix}}i/previous, core{{/pix}}</button>{{/hasprev}}
                            {{#hasnext}}<a class="btn btn-outline-secondary btn-sm btn-icon" href="{{nexturl}}" title="{{#str}}pagination_next, local_servicemanager{{/str}}" aria-label="{{#str}}pagination_next, local_servicemanager{{/str}}">{{#pix}}i/next, core{{/pix}}</a>{{/hasnext}}
                            {{^hasnext}}<button type="button" class="btn btn-outline-secondary btn-sm btn-icon" disabled aria-label="{{#str}}pagination_next, local_servicemanager{{/str}}">{{#pix}}i/next, core{{/pix}}</button>{{/hasnext}}
                        </div>
                    </div>
                </nav>
            </div>
            {{/pager}}
        </div>
        {{#js}}
            document.querySelectorAll('[data-region="health-perpage"] select').forEach(function(select) {
                select.addEventListener('change', function() {
                    select.form.submit();
                });
            });
        {{/js}}
    {{/hasany}}
</div>
