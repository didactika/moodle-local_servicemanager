{{!
    @template local_servicemanager/import_result_page

    What an import did, schema by schema.

    Context variables required for this template:
    * subtitle - A line that says how it went
    * imported, skipped, failed, warnings - Totals
    * items - The schemas of the import
    * dashboardurl, againurl - Where the person goes next

    Example context (json):
    {
        "subtitle": "Done",
        "imported": 1,
        "skipped": 0,
        "failed": 0,
        "failedtone": "secondary",
        "warnings": 0,
        "warningstone": "secondary",
        "hasitems": false,
        "items": [],
        "dashboardurl": "#",
        "againurl": "#"
    }
}}
<div class="lsm servicemanager-import-result">
    <header class="dd-page-header mb-3">
        <div>
            <h2 class="dd-page-title">{{#str}}import_result_title, local_servicemanager{{/str}}</h2>
            <p class="dd-page-subtitle">{{subtitle}}</p>
        </div>
        <div class="dd-page-actions">
            <a href="{{dashboardurl}}" class="btn btn-primary">{{#pix}}list, local_servicemanager{{/pix}} {{#str}}dashboard, local_servicemanager{{/str}}</a>
            <a href="{{againurl}}" class="btn btn-outline-secondary">{{#pix}}i/import, core{{/pix}} {{#str}}import_again, local_servicemanager{{/str}}</a>
        </div>
    </header>

    <div class="row" data-region="summary">
        <div class="col-6 col-md-3 mb-3"><div class="card h-100"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between gap-2"><span class="text-muted small text-uppercase fw-semibold">{{#str}}import_imported, local_servicemanager{{/str}}</span><span class="text-success">{{#pix}}i/valid, core{{/pix}}</span></div>
            <div class="h4 fw-bold mb-0 text-success">{{imported}}</div>
        </div></div>
        <div class="col-6 col-md-3 mb-3"><div class="card h-100"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between gap-2"><span class="text-muted small text-uppercase fw-semibold">{{#str}}import_skipped, local_servicemanager{{/str}}</span><span class="text-muted">{{#pix}}t/right, core{{/pix}}</span></div>
            <div class="h4 fw-bold mb-0">{{skipped}}</div>
        </div></div>
        <div class="col-6 col-md-3 mb-3"><div class="card h-100"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between gap-2"><span class="text-muted small text-uppercase fw-semibold">{{#str}}import_failed, local_servicemanager{{/str}}</span><span class="text-{{failedtone}}">{{#pix}}i/invalid, core{{/pix}}</span></div>
            <div class="h4 fw-bold mb-0 text-{{failedtone}}">{{failed}}</div>
        </div></div>
        <div class="col-6 col-md-3 mb-3"><div class="card h-100"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between gap-2"><span class="text-muted small text-uppercase fw-semibold">{{#str}}import_warnings, local_servicemanager{{/str}}</span><span class="text-{{warningstone}}">{{#pix}}i/warning, core{{/pix}}</span></div>
            <div class="h4 fw-bold mb-0 text-{{warningstone}}">{{warnings}}</div>
        </div></div>
    </div>

    {{#hasitems}}
        <div class="card">
            <ul class="list-group list-group-flush" data-region="import-items">
                {{#items}}
                    <li class="list-group-item">
                        <div>
                            <span class="text-{{tone}}">{{{iconhtml}}}</span>
                            <div class="flex-grow-1">
                                <div>
                                    {{#viewurl}}<a href="{{viewurl}}" class="font-weight-bold fw-bold">{{label}}</a>{{/viewurl}}{{^viewurl}}<strong>{{label}}</strong>{{/viewurl}}
                                    {{#showid}}<span class="small text-muted ms-2">{{#pix}}fingerprint, local_servicemanager{{/pix}} {{id}}</span>{{/showid}}
                                    <span class="badge badge-soft rounded-pill text-bg-{{tone}} ms-2">{{statuslabel}}</span>
                                </div>
                                {{#hasmessages}}
                                    <ul class="small list-unstyled mb-0{{#failed}} text-danger{{/failed}}{{^failed}} text-muted{{/failed}}">
                                        {{#messages}}<li>{{text}}</li>{{/messages}}
                                    </ul>
                                {{/hasmessages}}
                            </div>
                        </div>
                    </li>
                {{/items}}
            </ul>
        </div>
    {{/hasitems}}
</div>
