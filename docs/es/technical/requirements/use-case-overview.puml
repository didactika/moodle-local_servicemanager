@startuml
' generated by rup-flow (index); edit the use-case cards, not this file
!theme plain
skinparam linetype polyline
left to right direction

actor "Administrator" as A_Administrator
actor "Maintainer" as A_Maintainer
actor "System" as A_System

rectangle "local_servicemanager" {
  package "Schemas" {
    usecase "Crear un esquema" as UC_createSchema
    usecase "Actualizar un esquema" as UC_updateSchema
    usecase "Deshacer hasta una versión" as UC_rollbackSchema
  }
  package "Health" {
    usecase "Comprobar la salud de los esquemas" as UC_checkHealth
  }
  package "Administration" {
    usecase "Activar o desactivar los servicios web y sus protocolos" as UC_turnWebServices
  }
}

A_Maintainer --> UC_createSchema
A_Maintainer --> UC_updateSchema
A_Maintainer --> UC_rollbackSchema
A_System --> UC_checkHealth
A_Administrator --> UC_turnWebServices

@enduml
