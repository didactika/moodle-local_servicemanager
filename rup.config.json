{
  "project": "local_servicemanager",
  "outDir": "docs/en/technical",
  "docLanguage": "en",
  "codeRoot": "classes",
  "paths": {
    "domain": "domain",
    "requirements": "requirements",
    "analysis": "analysis",
    "design": "design",
    "implementation": "implementation",
    "quality": "quality"
  },
